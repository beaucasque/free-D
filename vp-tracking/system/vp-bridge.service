# Service utilisateur pour le bridge Free-D.
#
# Installation :
#   mkdir -p ~/.config/systemd/user
#   cp vp-bridge.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now vp-bridge
#
# Journal :  journalctl --user -u vp-bridge -f
#
# NOTE : ce service occupe le port serie. tools/deploy-firmware.sh l'arrete
# et le redemarre automatiquement.

[Unit]
Description=Bridge tracking Free-D (tracker + encodeurs objectif) vers Unreal
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/vp-tracking/bridge
ExecStart=%h/vp-tracking/bridge/vp_bridge.py --source survive --port /dev/vp_encoders --host 127.0.0.1 --rate 60
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
